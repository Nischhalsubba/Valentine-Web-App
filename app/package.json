{
  "name": "valentine-web-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A private, bilingual, multi-step digital love-letter experience built with React, TypeScript, Vite, accessible motion, persistent progress, interactive memories, a relationship quiz, and a hold-to-reveal finale.",
  "author": "Nischhal Raj Subba",
  "license": "UNLICENSED",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false",
    "check": "npm run typecheck && npm run build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.8.2",
    "@mojs/core": "^1.0.0",
    "@react-spring/web": "^9.7.5",
    "animejs": "^3.2.2",
    "motion": "^11.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-transition-group": "^4.4.5",
    "velocity-animate": "^2.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-transition-group": "^4.4.12",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
